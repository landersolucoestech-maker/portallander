{
  "name": "@portallander/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "check:architecture": "node scripts/check-unified-admin.mjs && node scripts/check-internal-boundaries.mjs && node scripts/check-chat-boundaries.mjs && node scripts/check-rh-boundaries.mjs && node scripts/check-data-boundaries.mjs && node scripts/check-ui-system.mjs && node scripts/check-site-module.mjs && node scripts/check-editorial-sections.mjs",
    "test": "vitest run",
    "test:visual": "playwright test --reporter=line",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
